<mxfile host="app.diagrams.net"><diagram name="Sample construction" id="s1"><mxGraphModel dx="740" dy="638" grid="1" gridSize="10" guides="1" page="1" pageWidth="740" pageHeight="638"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="&lt;b&gt;Original journal articles in OpenAlex, 2015–2020&lt;/b&gt;&lt;br&gt;19,896,656 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;With a title and a publishing journal; reviews, retractions, and duplicates excluded&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="340" height="58" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Journal scope score and comparison set available&lt;/b&gt;&lt;br&gt;15,233,734 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Publishing journal had at least 100 articles in the preceding three years&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="340" height="58" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Narrowest- or broadest-scope quartile of the comparison set&lt;/b&gt;&lt;br&gt;7,683,322 papers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="340" height="58" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Eligible papers&lt;/b&gt;&lt;br&gt;7,617,662 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Broader-scope journals 3,268,625; narrower-scope journals 4,349,037&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="340" height="58" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Primary comparison sample&lt;/b&gt;&lt;br&gt;3,818,173 papers from 20,203 journals&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Estimated probability of narrower-scope publication between 0.05 and 0.95&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="340" height="58" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Excluded&lt;/b&gt;&lt;br&gt;4,662,922 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;No reliable journal scope score or no comparison set&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="440" y="77" width="260" height="58" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;Excluded&lt;/b&gt;&lt;br&gt;7,550,412 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Middle half of the journal-scope distribution&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="440" y="171" width="260" height="58" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Excluded&lt;/b&gt;&lt;br&gt;65,660 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Title outside the calibrated range of the Qwen3 classification&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="440" y="265" width="260" height="58" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Excluded&lt;/b&gt;&lt;br&gt;3,799,489 papers&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Outside common support of the two journal groups&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="440" y="359" width="260" height="58" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Regenerated comparison sample&lt;/b&gt;&lt;br&gt;3,827,491 papers from 20,215 journals&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Broader-scope 1,535,843; narrower-scope 2,291,648. Second fit of the same specification, storing paper-level scores for the year, area, network, and journal-pair analyses&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="340" height="78" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Citations to these papers within five years&lt;/b&gt;&lt;br&gt;31,853,837 citation links&lt;br&gt;&lt;font style=&quot;font-size: 8px&quot;&gt;Same journal or shared author, excluded 7,406,045; citing paper unclassified 837,858; analyzed 23,609,934&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" par